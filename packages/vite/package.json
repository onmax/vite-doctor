{
  "name": "vite-doctor",
  "version": "0.0.0",
  "description": "Universal CLI command runner for JavaScript projects.",
  "keywords": [
    "cli",
    "doctor",
    "javascript",
    "vite"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/vite"
  },
  "bin": {
    "vite-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "default": "./dist/nuxt.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/cli.ts src/nuxt.ts src/plugin.ts",
    "dev": "vp pack src/index.ts src/cli.ts src/nuxt.ts src/plugin.ts --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@vue-doctor/core": "workspace:*",
    "nuxt-doctor": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
