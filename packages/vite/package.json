{
  "name": "vite-doctor",
  "version": "0.0.1-alpha.1",
  "description": "Small Vite Doctor CLI for project diagnostics.",
  "keywords": [
    "cli",
    "doctor",
    "javascript",
    "vite"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/vite"
  },
  "bin": {
    "vite-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "consola": "^3.4.2",
    "oxc-parser": "^0.129.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@vue-doctor/core": "workspace:*",
    "nuxt-doctor": "workspace:*",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-doctor": "workspace:*"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
