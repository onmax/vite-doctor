{
  "name": "vite-doctor",
  "version": "0.0.1-alpha.2",
  "description": "Small Vite Doctor CLI for project diagnostics.",
  "keywords": [
    "cli",
    "doctor",
    "javascript",
    "vite"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/vite"
  },
  "bin": {
    "vite-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./rules": "./dist/rules.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@vue-doctor/core": "workspace:*",
    "cac": "^6.7.14",
    "consola": "^3.4.2",
    "oxc-parser": "catalog:",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@nuxt/kit": "4.4.4",
    "acorn": "8.16.0",
    "confbox": "0.1.8",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "exsolve": "1.0.8",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "magic-string": "0.30.21",
    "mlly": "1.8.2",
    "picocolors": "1.1.1",
    "pkg-types": [
      "1.3.1",
      "2.3.1"
    ],
    "rc9": "3.0.1",
    "semver": "7.8.0",
    "ufo": "1.6.4",
    "unctx": "2.5.0"
  }
}
