{
  "name": "nitro-doctor",
  "version": "0.0.0",
  "private": true,
  "description": "CLI diagnostics rule pack for Nitro projects using Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "nitro",
    "static-analysis"
  ],
  "homepage": "https://github.com/onmax/vite-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/vite-doctor.git",
    "directory": "packages/nitro"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./rules": "./dist/rules.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@vue-doctor/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "vite-plus": "catalog:build"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "nostics": "0.3.0"
  }
}
