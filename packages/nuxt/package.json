{
  "name": "nuxt-doctor",
  "version": "0.0.0",
  "private": true,
  "description": "CLI and Nuxt module diagnostics for Nuxt projects using Nuxt Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/vite-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/vite-doctor.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./module": "./dist/module.mjs",
    "./rules": "./dist/rules/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:frontend",
    "@vue-doctor/core": "workspace:*",
    "cac": "catalog:prod",
    "consola": "catalog:prod",
    "nitro-doctor": "workspace:*",
    "oxc-parser": "catalog:analysis",
    "pathe": "catalog:prod",
    "vue-doctor": "workspace:*",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:deploy",
    "@nuxt/content": "catalog:frontend",
    "@nuxt/scripts": "catalog:frontend",
    "@nuxt/test-utils": "catalog:test",
    "@nuxt/ui": "catalog:frontend",
    "@testing-library/vue": "catalog:test",
    "@tiptap/core": "catalog:frontend",
    "@tiptap/extensions": "catalog:frontend",
    "@tiptap/pm": "catalog:frontend",
    "@tiptap/y-tiptap": "catalog:frontend",
    "@vue/test-utils": "catalog:test",
    "@vueuse/core": "catalog:frontend",
    "better-auth": "catalog:frontend",
    "happy-dom": "catalog:test",
    "nuxt": "catalog:frontend",
    "nuxt-better-auth": "catalog:frontend",
    "tsdown": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "nuxt": ">=4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "c12": "4.0.0-beta.5",
    "confbox": "0.2.4",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "dotenv": "17.4.2",
    "exsolve": "1.0.8",
    "giget": "3.2.0",
    "jiti": "2.7.0",
    "nostics": "0.3.0",
    "pkg-types": "2.3.1",
    "rc9": "3.0.1"
  }
}
