{
  "name": "nuxt-doctor",
  "version": "0.0.0",
  "description": "CLI and Nuxt module diagnostics for Nuxt projects using Nuxt Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/nuxt"
  },
  "bin": {
    "nuxt-doctor": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./module": {
      "types": "./dist/module.d.mts",
      "default": "./dist/module.mjs"
    },
    "./rules": {
      "types": "./dist/rules/index.d.mts",
      "default": "./dist/rules/index.mjs"
    },
    "./runtime/mcp/tools/doctor-report": {
      "types": "./dist/runtime/mcp/tools/doctor-report.d.mts",
      "default": "./dist/runtime/mcp/tools/doctor-report.mjs"
    },
    "./runtime/mcp/tools/doctor-rules": {
      "types": "./dist/runtime/mcp/tools/doctor-rules.d.mts",
      "default": "./dist/runtime/mcp/tools/doctor-rules.mjs"
    },
    "./runtime/mcp/tools/doctor-explain-rule": {
      "types": "./dist/runtime/mcp/tools/doctor-explain-rule.d.mts",
      "default": "./dist/runtime/mcp/tools/doctor-explain-rule.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/module.ts src/cli.ts src/bin.ts src/rules/index.ts src/runtime/mcp/tools/doctor-report.ts src/runtime/mcp/tools/doctor-rules.ts src/runtime/mcp/tools/doctor-explain-rule.ts",
    "dev": "vp pack src/index.ts src/module.ts src/cli.ts src/bin.ts src/rules/index.ts src/runtime/mcp/tools/doctor-report.ts src/runtime/mcp/tools/doctor-rules.ts src/runtime/mcp/tools/doctor-explain-rule.ts --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxtjs/mcp-toolkit": "catalog:",
    "@vue-doctor/core": "workspace:*",
    "agents": "catalog:",
    "pathe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/content": "catalog:",
    "@nuxt/scripts": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@testing-library/vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "better-auth": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "nuxt-better-auth": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nuxt": ">=4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
