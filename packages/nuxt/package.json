{
  "name": "nuxt-doctor",
  "version": "0.0.0",
  "description": "CLI and Nuxt module diagnostics for Nuxt projects using Nuxt Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/nuxt"
  },
  "bin": {
    "nuxt-doctor": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./cli": "./dist/cli.mjs",
    "./module": "./dist/module.mjs",
    "./rules": "./dist/rules/index.mjs",
    "./runtime/mcp/tools/doctor-dead-code": "./dist/runtime/mcp/tools/doctor-dead-code.mjs",
    "./runtime/mcp/tools/doctor-duplicates": "./dist/runtime/mcp/tools/doctor-duplicates.mjs",
    "./runtime/mcp/tools/doctor-explain-diagnostic": "./dist/runtime/mcp/tools/doctor-explain-diagnostic.mjs",
    "./runtime/mcp/tools/doctor-explain-rule": "./dist/runtime/mcp/tools/doctor-explain-rule.mjs",
    "./runtime/mcp/tools/doctor-graph": "./dist/runtime/mcp/tools/doctor-graph.mjs",
    "./runtime/mcp/tools/doctor-health": "./dist/runtime/mcp/tools/doctor-health.mjs",
    "./runtime/mcp/tools/doctor-refs": "./dist/runtime/mcp/tools/doctor-refs.mjs",
    "./runtime/mcp/tools/doctor-report": "./dist/runtime/mcp/tools/doctor-report.mjs",
    "./runtime/mcp/tools/doctor-rules": "./dist/runtime/mcp/tools/doctor-rules.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxtjs/mcp-toolkit": "catalog:",
    "@vue-doctor/core": "workspace:*",
    "agents": "catalog:",
    "cac": "catalog:",
    "consola": "catalog:",
    "nitro-doctor": "workspace:*",
    "pathe": "catalog:",
    "vue-doctor": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/content": "catalog:",
    "@nuxt/scripts": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@testing-library/vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "better-auth": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "nuxt-better-auth": "catalog:",
    "tsdown": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nuxt": ">=4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "c12": "4.0.0-beta.5",
    "confbox": "0.2.4",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "dotenv": "17.4.2",
    "exsolve": "1.0.8",
    "giget": "3.2.0",
    "jiti": "2.7.0",
    "oxc-parser": "0.129.0",
    "pkg-types": "2.3.1",
    "rc9": "3.0.1"
  }
}
