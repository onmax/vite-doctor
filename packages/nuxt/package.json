{
  "name": "nuxt-doctor",
  "version": "0.0.0",
  "private": true,
  "description": "CLI and Nuxt module diagnostics for Nuxt projects using Nuxt Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/vite-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/vite-doctor.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./module": "./dist/module.mjs",
    "./rules": "./dist/rules/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@vue-doctor/core": "workspace:*",
    "cac": "catalog:",
    "consola": "catalog:",
    "nitro-doctor": "workspace:*",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "vue-doctor": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/content": "catalog:",
    "@nuxt/scripts": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@testing-library/vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "better-auth": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "nuxt-better-auth": "catalog:",
    "tsdown": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nuxt": ">=4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "defu": "6.1.7",
    "nostics": "0.1.0"
  }
}
