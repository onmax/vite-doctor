{
  "name": "@vue-doctor/config",
  "version": "0.0.0",
  "description": "Trusted executable config loading for Doctor packages.",
  "keywords": [
    "config",
    "doctor",
    "static-analysis"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@vue-doctor/core": "workspace:*",
    "c12": "catalog:",
    "defu": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
