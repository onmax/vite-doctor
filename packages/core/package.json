{
  "name": "@vue-doctor/core",
  "version": "0.0.0",
  "description": "Core analyzer, rule, plugin, and reporting APIs for Vue Doctor and Nuxt Doctor.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./reports": {
      "types": "./dist/reports.d.mts",
      "default": "./dist/reports.mjs"
    },
    "./testkit": {
      "types": "./dist/testkit.d.mts",
      "default": "./dist/testkit.mjs"
    },
    "./internal/nuxt-inventory": {
      "types": "./dist/internal/nuxt-inventory.d.mts",
      "default": "./dist/internal/nuxt-inventory.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/config.ts src/reports.ts src/testkit.ts src/internal/nuxt-inventory.ts src/internal/source-inventory.ts src/internal/rule-runner.ts src/internal/diagnostic-policy.ts",
    "dev": "vp pack src/index.ts src/config.ts src/reports.ts src/testkit.ts src/internal/nuxt-inventory.ts src/internal/source-inventory.ts src/internal/rule-runner.ts src/internal/diagnostic-policy.ts --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@typescript-eslint/parser": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "c12": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "picocolors": "catalog:",
    "tinyexec": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
