{
  "name": "@vue-doctor/core",
  "version": "0.0.0",
  "description": "Core analyzer, rule, plugin, and reporting APIs for Vue Doctor and Nuxt Doctor.",
  "keywords": [
    "doctor",
    "lint",
    "nuxt",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./internal/cli": "./dist/internal/cli.mjs",
    "./internal/diagnostic-policy": "./dist/internal/diagnostic-policy.mjs",
    "./internal/nuxt-inventory": "./dist/internal/nuxt-inventory.mjs",
    "./internal/rule-runner": "./dist/internal/rule-runner.mjs",
    "./internal/source-inventory": "./dist/internal/source-inventory.mjs",
    "./reports": "./dist/reports.mjs",
    "./testkit": "./dist/testkit.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@typescript-eslint/parser": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "c12": "catalog:",
    "defu": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "picocolors": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
