{
  "name": "vue-doctor",
  "version": "0.0.0",
  "description": "CLI diagnostics for Vue projects using Vue Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/vue"
  },
  "bin": {
    "vue-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/cli.d.mts",
  "exports": {
    "./cli": "./dist/cli.mjs",
    "./rules": "./dist/rules.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@typescript-eslint/parser": "catalog:",
    "@vue-doctor/core": "workspace:*",
    "cac": "catalog:",
    "consola": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "c12": "4.0.0-beta.5",
    "confbox": "0.2.4",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "dotenv": "17.4.2",
    "exsolve": "1.0.8",
    "giget": "3.2.0",
    "jiti": "2.7.0",
    "pkg-types": "2.3.1",
    "rc9": "3.0.1"
  }
}
