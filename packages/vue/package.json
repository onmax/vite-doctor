{
  "name": "vue-doctor",
  "version": "0.0.0",
  "private": true,
  "description": "CLI diagnostics for Vue projects using Vue Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/vite-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/vite-doctor.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "types": "./dist/rules.d.mts",
  "exports": {
    ".": "./dist/rules.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@typescript-eslint/parser": "catalog:",
    "@vue-doctor/core": "workspace:*",
    "cac": "catalog:",
    "consola": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "inlinedDependencies": {
    "nostics": "0.1.0"
  }
}
