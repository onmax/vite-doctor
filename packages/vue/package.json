{
  "name": "vue-doctor",
  "version": "0.0.0",
  "description": "CLI diagnostics for Vue projects using Vue Doctor rules.",
  "keywords": [
    "doctor",
    "lint",
    "static-analysis",
    "vue"
  ],
  "homepage": "https://github.com/onmax/nuxt-doctor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-doctor.git",
    "directory": "packages/vue"
  },
  "bin": {
    "vue-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/cli.d.mts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/cli.ts",
    "dev": "vp pack src/cli.ts --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@vue-doctor/core": "workspace:*",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
