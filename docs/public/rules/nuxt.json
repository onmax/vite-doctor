      "source": "packages/nuxt/src/rules/nitro/prefer-validated-body.ts",
      "id": "nitro/request/prefer-validated-body",
      "title": "Use readValidatedBody for validated request bodies",
      "description": "When a Nitro handler validates a request body, read and validate it through the H3 utility.",
      "why": "Raw request input and validation can drift apart when they are separate operations. Nitro and h3 provide validated helpers that keep parsing and validation coupled at the request boundary.",
      "recommendedReplacement": "Use readValidatedBody(event, validator) instead of readBody(event) followed by separate validation.",
      "examples": [
        {
          "title": "Keep reading and validation together",
          "language": "ts",
          "invalid": "export default defineEventHandler(async (event) => {\n  const input = await readBody(event)\n  const value = validator.parse(input)\n\n  return value\n})",
          "valid": "export default defineEventHandler(async (event) => {\n  const value = await readValidatedBody(event, validator)\n\n  return value\n})"
        }
      ],
      "category": "request",
      "severity": "warn",
      "fixable": "suggestion",
